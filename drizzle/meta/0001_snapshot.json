        "orders_symbol_format_ck": {
          "name": "orders_symbol_format_ck",
          "value": "\"orders\".\"symbol\" ~ '^[A-Z0-9][A-Z0-9.-]{0,15}$'"
        },
        "orders_limit_price_positive_ck": {
          "name": "orders_limit_price_positive_ck",
          "value": "\"orders\".\"limit_price\" is null or (\"orders\".\"limit_price\" <> 'NaN'::numeric and \"orders\".\"limit_price\" > 0)"
        },
        "orders_quantity_positive_ck": {
          "name": "orders_quantity_positive_ck",
          "value": "\"orders\".\"quantity\" is null or (\"orders\".\"quantity\" <> 'NaN'::numeric and \"orders\".\"quantity\" > 0)"
        },
        "orders_filled_quantity_valid_ck": {
          "name": "orders_filled_quantity_valid_ck",
          "value": "\"orders\".\"filled_quantity\" <> 'NaN'::numeric and \"orders\".\"filled_quantity\" >= 0 and (\"orders\".\"quantity\" is null or \"orders\".\"filled_quantity\" <= \"orders\".\"quantity\")"
        },
        "orders_known_state_consistent_ck": {
          "name": "orders_known_state_consistent_ck",
          "value": "(\"orders\".\"status\" = 'UNKNOWN' and \"orders\".\"legacy_import\") or (\"orders\".\"status\" = 'OPEN' and \"orders\".\"quantity\" is not null and \"orders\".\"filled_quantity\" = 0) or (\"orders\".\"status\" = 'PARTIALLY_FILLED' and \"orders\".\"quantity\" is not null and \"orders\".\"filled_quantity\" > 0 and \"orders\".\"filled_quantity\" < \"orders\".\"quantity\") or (\"orders\".\"status\" = 'FILLED' and \"orders\".\"quantity\" is not null and \"orders\".\"filled_quantity\" = \"orders\".\"quantity\") or (\"orders\".\"status\" = 'CANCELLED' and \"orders\".\"quantity\" is not null and \"orders\".\"filled_quantity\" < \"orders\".\"quantity\")"
        },
        "orders_nonlegacy_complete_ck": {
          "name": "orders_nonlegacy_complete_ck",
          "value": "\"orders\".\"legacy_import\" or (\"orders\".\"quantity\" is not null and \"orders\".\"status\" <> 'UNKNOWN')"
        },
        "orders_limit_price_consistent_ck": {
          "name": "orders_limit_price_consistent_ck",
          "value": "case when \"orders\".\"order_type\" = 'LIMIT' then \"orders\".\"limit_price\" is not null else \"orders\".\"limit_price\" is null end"
        }
